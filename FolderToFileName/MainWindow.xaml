<Window x:Class="FolderToFileName.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文件名前置上层目录名工具" Height="680" Width="960"
        WindowStartupLocation="CenterScreen" MinWidth="800" MinHeight="550"
        Icon="logo.ico">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <!-- 第一部分：目录选择 -->
            <RowDefinition Height="Auto"/>
            <!-- 第二部分：选项区域 -->
            <RowDefinition Height="Auto"/>
            <!-- 第三部分：预览表格 -->
            <RowDefinition Height="*"/>
            <!-- 第四部分：执行与撤销按钮 -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 《第一部分》 -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="目标目录：" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Bold"/>
            <TextBox x:Name="TxtTargetDir" Grid.Column="1" VerticalContentAlignment="Center" Height="28" IsReadOnly="True"/>
            <Button x:Name="BtnBrowse" Grid.Column="2" Content="选择..." Width="80" Height="28" Margin="8,0,0,0" Click="BtnBrowse_Click"/>
        </Grid>

        <!-- 《第二部分》 -->
        <Border Grid.Row="1" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10" Background="#FAFAFA">
            <StackPanel Orientation="Vertical">
                <!-- 文本输入选项 -->
                <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" Margin="0,2,20,2">
                        <CheckBox x:Name="ChkPrefix" Content="目录名前缀" VerticalAlignment="Center" Checked="OnOptionChangedImmediate" Unchecked="OnOptionChangedImmediate"/>
                        <TextBox x:Name="TxtPrefix" Width="90" Height="24" Margin="6,0,0,0" VerticalContentAlignment="Center" TextChanged="OnTextChanged" PreviewTextInput="OnPreviewTextInput"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,2,20,2">
                        <CheckBox x:Name="ChkSuffix" Content="目录名后缀" VerticalAlignment="Center" Checked="OnOptionChangedImmediate" Unchecked="OnOptionChangedImmediate"/>
                        <TextBox x:Name="TxtSuffix" Width="90" Height="24" Margin="6,0,0,0" VerticalContentAlignment="Center" TextChanged="OnTextChanged" PreviewTextInput="OnPreviewTextInput"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,2,20,2">
                        <CheckBox x:Name="ChkSeparator" Content="目录/文件名分隔符" VerticalAlignment="Center" Checked="OnOptionChangedImmediate" Unchecked="OnOptionChangedImmediate"/>
                        <TextBox x:Name="TxtSeparator" Width="90" Height="24" Margin="6,0,0,0" VerticalContentAlignment="Center" TextChanged="OnTextChanged" PreviewTextInput="OnPreviewTextInput"/>
                    </StackPanel>
                </WrapPanel>

                <!-- 复选框逻辑选项：勾选切换立即执行刷新 -->
                <WrapPanel Orientation="Horizontal">
                    <CheckBox x:Name="ChkIncludeSubdirs" Content="包含子目录" Margin="0,4,20,4" Checked="OnOptionChangedImmediate" Unchecked="OnOptionChangedImmediate"/>
                    <CheckBox x:Name="ChkIncludeAllParents" Content="文件名包含所有上级目录名" Margin="0,4,20,4" Checked="OnOptionChangedImmediate" Unchecked="OnOptionChangedImmediate"/>
                    <CheckBox x:Name="ChkLimitExtensions" Content="通过配置文件限定文件扩展名" Margin="0,4,20,4" Checked="OnOptionChangedImmediate" Unchecked="OnOptionChangedImmediate"/>
                    <CheckBox x:Name="ChkMoveToRoot" Content="将文件移动到最上层目录" Margin="0,4,20,4" Checked="OnOptionChangedImmediate" Unchecked="OnOptionChangedImmediate"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 《第三部分》 预览表格 -->
        <DataGrid x:Name="DgPreview" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"
                  CanUserDeleteRows="False" IsReadOnly="True" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEEEEE"
                  Background="White" RowHeight="26">
            <DataGrid.Columns>
                <DataGridTextColumn Header="原文件" Binding="{Binding RelativeSourcePath}" Width="3*"/>
                <DataGridTextColumn Header="目标文件" Binding="{Binding RelativeTargetPath}" Width="3*"/>
                <DataGridTemplateColumn Header="文件状态" Width="1.5*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StatusDisplayText}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 《第四部分》 底部信息与操作按钮 -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 作者与版本信息超链接 -->
            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="12">
                <Hyperlink NavigateUri="https://github.com/tpz9911" 
                           RequestNavigate="Hyperlink_RequestNavigate"
                           ToolTip="点击访问作者主页">
                    PZ v0.99.260922
                </Hyperlink>
            </TextBlock>

            <!-- 右侧操作按钮 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnExecute" Content="执行" Width="100" Height="30" Margin="0,0,12,0" IsEnabled="False" Click="BtnExecute_Click"/>
                <Button x:Name="BtnUndo" Content="撤销" Width="100" Height="30" IsEnabled="False" Click="BtnUndo_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>